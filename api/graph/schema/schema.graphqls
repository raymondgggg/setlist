# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type User {
  id: ID!
  firstName: String!
  lastName: String!
}

type Test {
  name: String
}

extend type Query {
  users: [User!]!
}

input NewUser {
  firstName: String!
  lastName: String!
}

extend type Mutation {
  createUser(input: NewUser!): User!
}
