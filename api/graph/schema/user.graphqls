extend type Query {
  user(id: ID!): User
  users: [User!]!
}

extend type Mutation {
  createUser(input: NewUser!): User! @public
  verifyEmail(token: String!): Boolean! @public
}

type User {
  id: ID!
  firstName: String
  lastName: String
  email: String!
}

input NewUser {
  firstName: String
  lastName: String
  email: String!
  password: String!
}
