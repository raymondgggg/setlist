# Database host
DB_HOST=""
# Database port
DB_PORT=""
# Database user
DB_USER=""
# Database password
DB_PASSWORD=""
# Database name
DB_NAME=""
# JWT Secret
JWT_SECRET=""
# Environment, e.g. "development"
APP_ENV=""
# Resend API Key
RESEND_API_KEY=""
# Email from address
EMAIL_FROM=""
# Frontend base URL used in emailed links. Defaults to "http://localhost:5173" outside production, required in production
# (must include the scheme)
FRONTEND_BASE_URL=""
# Local dev only: set to "true" to log verification links instead of sending email via Resend (refused when APP_ENV=production)
EMAIL_LOG_ONLY=""
